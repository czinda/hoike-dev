{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoike-dev",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./deploy",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  // Native Worker custom domains own DNS and certificates; no Pages origin.
  "routes": [
    { "pattern": "hoike.dev", "custom_domain": true },
    { "pattern": "www.hoike.dev", "custom_domain": true }
  ]
}
